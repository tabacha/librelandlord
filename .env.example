# Umgebungsvariablen für LibreLandlord OIDC-Konfiguration

# ======= DEMO/DEVELOPMENT SETUP =======
# Für lokale Entwicklung und Tests
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
USE_OIDC_ONLY=False

# ======= PRODUCTION SETUP =======
# Für Live-System mit Docker
# DEBUG=False
# ALLOWED_HOSTS=your-domain.com,your-server-ip
# USE_OIDC_ONLY=True

# ======= KEYCLOAK/OIDC KONFIGURATION =======
# Diese Werte müssen für beide Umgebungen gesetzt werden

# Keycloak Server URL (UCS)
KEYCLOAK_SERVER=https://your-ucs-server.domain.com

# Keycloak Realm Name
KEYCLOAK_REALM=librelandlord

# Client-Konfiguration (von Keycloak Admin Console)
OIDC_CLIENT_ID=librelandlord-django
OIDC_CLIENT_SECRET=your-generated-client-secret

# ======= BEISPIEL FÜR UCS SETUP =======
# KEYCLOAK_SERVER=https://ucs.example.com
# KEYCLOAK_REALM=librelandlord
# OIDC_CLIENT_ID=librelandlord-django
# OIDC_CLIENT_SECRET=abc123def456ghi789

# ======= EMAIL KONFIGURATION =======
# SMTP-Server Einstellungen
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password
# DEFAULT_FROM_EMAIL=noreply@example.com

# Debug-Modus: Alle E-Mails an diese Adresse umleiten (für Tests)
# Wenn gesetzt, werden alle E-Mails an diese Adresse geschickt statt an die echten Empfänger
# EMAIL_DEBUG_RECIPIENT=debug@example.com

# Site URL für Links in E-Mails
# SITE_URL=https://nebenkosten.anders.hamburg
