# Umgebungsvariablen für LibreLandlord Production Deployment
# Für docker-compose.ghcr.yml

# ======= KEYCLOAK/UCS KONFIGURATION =======
KEYCLOAK_SERVER=https://your-ucs-server.domain.com
KEYCLOAK_REALM=librelandlord
OIDC_CLIENT_ID=librelandlord-django
OIDC_CLIENT_SECRET=your-generated-client-secret

# ======= HOST-KONFIGURATION =======
ALLOWED_HOSTS=your-domain.com,your-server-ip
# Vollständige URL für externe Links (z.B. in E-Mails an Mieter)
SITE_URL=https://your-domain.com

# ======= MARIADB-KONFIGURATION =======
# Passwörter werden über Docker Secrets verwaltet (siehe secrets/ Verzeichnis)
MYSQL_DATABASE=librelandlord
MYSQL_USER=librelandlord

# ======= EMAIL-KONFIGURATION =======
# SMTP-Server für E-Mail-Versand
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password
# DEFAULT_FROM_EMAIL=noreply@example.com

# Debug-Modus: Alle E-Mails an diese Adresse umleiten (für Tests)
# EMAIL_DEBUG_RECIPIENT=debug@example.com

# ======= BEISPIEL =======
# KEYCLOAK_SERVER=https://ucs.example.com
# KEYCLOAK_REALM=librelandlord
# OIDC_CLIENT_ID=librelandlord-django
# OIDC_CLIENT_SECRET=abc123def456ghi789
# ALLOWED_HOSTS=librelandlord.example.com,192.168.1.100
#
# MariaDB-Passwörter werden über Docker Secrets verwaltet:
# echo "superSecureRootPassword123" > secrets/mariadb_root_password.txt
# echo "secureLibreLandlordDBPassword456" > secrets/mariadb_password.txt
